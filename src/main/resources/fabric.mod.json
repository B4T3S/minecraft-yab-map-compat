{
	"schemaVersion": 1,
	"id": "minecraft-yab-map-compat",
	"version": "${version}",
	"name": "Minecraft YAB Map-Compat",
	"description": "This mod resets your favourite map mod (Xaero's or Journeymap) when the game is about to start!",
	"authors": [
		"B4T3S"
	],
	"contact": {
		"homepage": "https://github.com/B4T3S/minecraft-yab-map-compat",
		"sources": "https://github.com/B4T3S/minecraft-yab-map-compat",
		"issues": "https://github.com/B4T3S/minecraft-yab-map-compat/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/minecraft-yab-map-compat/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"es.b4t.MinecraftYABMapCompat"
		],
		"client": [
			"es.b4t.client.MinecraftYABMapCompatClient"
		]
	},
	"mixins": [
		"minecraft-yab-map-compat.mixins.json",
		{
			"config": "minecraft-yab-map-compat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"yet-another-minecraft-bingo": ">=2"
	}
}